# Lord of the Realms - Unity projekt
#
# VAZNO: Unity projekt nije u korijenu repozitorija nego u podmapi
# "CARD PROJECT". Zato se ovdje NE koriste uzorci s kosom crtom na pocetku
# (npr. /Library/), jer oni znace "samo u korijenu repozitorija" i ne bi
# uhvatili "CARD PROJECT/Library/". Uzorci bez pocetne kose crte hvataju
# mapu na bilo kojoj dubini, sto je ovdje potrebno.
#
# Predlozak: https://github.com/github/gitignore/blob/main/Unity.gitignore

# ---------------------------------------------------------------
# Unity generirane mape. Library je najveca, oko 2.5 GB i 48000
# datoteka, i Unity je u cijelosti ponovno izgradi iz Assets i
# ProjectSettings. Nikad ne ide u repozitorij.
# ---------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/

# ---------------------------------------------------------------
# Razvojna okruzenja i generirani projektni fajlovi
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
.vsconfig
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.log

# Rider dodatak koji Unity sam generira
[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------
# Meta datoteke za generirane binarne fajlove
# ---------------------------------------------------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------
# Izvezene igre i paketi
# ---------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe

# Izvjestaj o rusenju i Crashlytics
sysinfo.txt
crashlytics-build.properties

# Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------
# Operacijski sustav
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Sto OSTAJE u repozitoriju i ne smije se dodati ovdje:
#   Assets/           sav kod, karte, slike i zvuk
#   Packages/         popis Unity paketa (manifest.json, packages-lock.json)
#   ProjectSettings/  postavke projekta, ukljucujuci popis scena
# Bez te tri mape projekt se ne moze obnoviti iz repozitorija.
# ---------------------------------------------------------------
